{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/fonts/:name.:hash.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/checkout.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/confirmation.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/screenshots/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tfc/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/tfc/array/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/array/:path"
    },
    {
      "source": "/tfc/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    {
      "source": "/october",
      "destination": "/index"
    },
    {
      "source": "/regularticketoct",
      "destination": "/regularticket26"
    },
    {
      "source": "/vipticketoct",
      "destination": "/vipticket26"
    },
    {
      "source": "/vipupgradeoct",
      "destination": "/upgradevip"
    },
    {
      "source": "/prepkitoct",
      "destination": "/prepkit"
    },
    {
      "source": "/prepkitvipoct",
      "destination": "/prepkitvip"
    },
    {
      "source": "/taxreportoct",
      "destination": "/taxreport"
    },
    {
      "source": "/taxreportvipoct",
      "destination": "/taxreportvip"
    },
    {
      "source": "/octchallengeconfirmation",
      "destination": "/octchallengeconfirmation"
    },
    {
      "source": "/octchallengeconfirmationvip",
      "destination": "/octchallengeconfirmationvip"
    },
    {
      "source": "/octprechallengetraining",
      "destination": "/prechallengetraining123"
    }
  ]
}
